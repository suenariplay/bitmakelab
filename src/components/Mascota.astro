---
const { id = 'mascota', animo = 'feliz' } = Astro.props;
---
<svg
  class="mascota-svg"
  id={id}
  data-animo={animo}
  viewBox="0 0 200 190"
  role="img"
  aria-label="Bit, la mascota de bitmakelab"
>
  <g class="m-grupo">
    <path class="m-cola" d="M52 148 C22 156 2 132 12 110 C20 92 46 96 44 114 C42 128 24 126 26 114" fill="none" stroke-width="16" stroke-linecap="round" />
    <rect class="m-pata" x="58" y="156" width="14" height="24" rx="7" />
    <rect class="m-pata" x="90" y="156" width="14" height="24" rx="7" />
    <ellipse class="m-cuerpo" cx="78" cy="138" rx="38" ry="30" />
    <ellipse class="m-vientre" cx="82" cy="144" rx="22" ry="17" />
    <g class="m-cabeza">
      <path class="m-cresta" d="M92 46 l8 -22 l11 16 z M112 40 l9 -24 l12 19 z M134 46 l8 -19 l10 17 z" />
      <ellipse class="m-craneo" cx="124" cy="80" rx="48" ry="44" />
      <ellipse class="m-hocico" cx="166" cy="92" rx="16" ry="14" />
      <g class="m-ojo">
        <circle class="m-ojo-blanco" cx="134" cy="72" r="19" />
        <circle class="m-pupila" cx="136" cy="72" r="9.5" />
        <circle class="m-brillo" cx="140" cy="66" r="3.5" />
      </g>
      <ellipse class="m-mejilla" cx="146" cy="104" rx="10" ry="6" />
      <g class="m-bocas">
        <path class="boca boca-feliz" d="M152 104 q10 9 20 -1" fill="none" stroke="#07251A" stroke-width="4.5" stroke-linecap="round" />
        <ellipse class="boca boca-sorpresa" cx="161" cy="108" rx="8" ry="10" fill="#07251A" />
        <path class="boca boca-linea" d="M153 106 q9 3 18 0" fill="none" stroke="#07251A" stroke-width="4.5" stroke-linecap="round" />
        <path class="boca boca-guino" d="M152 104 q10 12 20 -3" fill="none" stroke="#07251A" stroke-width="4.5" stroke-linecap="round" />
      </g>
      <g class="m-cejas" stroke="#07251A" stroke-width="4" stroke-linecap="round">
        <path d="M118 54 l16 5" />
        <path d="M154 56 l-15 4" />
      </g>
      <g class="m-chispas">
        <path d="M178 44 l3 9 9 3 -9 3 -3 9 -3 -9 -9 -3 9 -3 z" />
        <path d="M60 62 l2 6 6 2 -6 2 -2 6 -2 -6 -6 -2 6 -2 z" />
      </g>
    </g>
  </g>
</svg>
